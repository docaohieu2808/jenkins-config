# cp .env.example .env, then fill in the values. Never commit .env.

# --- Required -------------------------------------------------------------
# Jenkins admin account created by JCasC (no setup wizard).
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Kubernetes cloud for ephemeral build agents.
# API server URL, a service-account bearer token and the cluster CA (base64 of the PEM, single line):
#   base64 -w0 ca.crt
K8S_SERVER_URL=https://k8s.example.internal:6443
K8S_TOKEN=change-me-service-account-token
K8S_CA_CERT_B64=change-me-base64-of-the-cluster-ca-pem

# Where the K8s agent pods reach this controller (must be routable from the cluster).
JENKINS_AGENT_URL=http://192.0.2.10:8080/
JENKINS_TUNNEL=192.0.2.10:50000

# --- Optional (defaults shown) --------------------------------------------
# Public URL users open, and the address both ports bind to on the host.
# JENKINS_PUBLIC_URL=http://localhost:8080/
# JENKINS_BIND_IP=127.0.0.1
# JENKINS_PORT=8080
# JENKINS_AGENT_PORT=50000
# TZ=Asia/Ho_Chi_Minh

# Shared library and its Git credential (HTTPS user + token).
# SHARED_LIB_REMOTE=https://git.example.com/group/jenkins-shared-library.git
# GIT_USERNAME=ci-bot
# GIT_PASSWORD=
GIT_PASSWORD=

# Mail (SMTP). Defaults point at Resend; leave the password empty to configure mail later.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# JENKINS_ADMIN_ADDRESS=Jenkins <jenkins@example.com>
SMTP_PASSWORD=
