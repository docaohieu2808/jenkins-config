# Copy this file to .env and fill in your values before starting Jenkins.
#   cp .env.example .env

# Jenkins admin credentials (required)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change_me_strong_password

# GitLab credentials used by JCasC to connect to git.example.com (required)
GITLAB_PASSWORD=your_gitlab_token_or_password

# WireGuard internal IP of this server — used by K8s cloud to reach Jenkins controller
# Set to the wg0 IP of the machine running this compose stack
JENKINS_WG_IP=10.10.0.X

# Optional overrides (defaults shown)
# JENKINS_VERSION=lts-jdk21
# JENKINS_HOST=jenkins.example.com
# JENKINS_PORT=8082
# JENKINS_AGENT_PORT=50000
# TZ=Asia/Ho_Chi_Minh
RESEND_SMTP_PASSWORD=
